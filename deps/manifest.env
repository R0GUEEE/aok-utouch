# Versions of everything that has to be cross-compiled before QEMU can be.
# Changing a line here changes the dependency hash, which invalidates both the
# Actions cache and any published prebuilt tarball, by design.
PIXMAN_VERSION=0.43.4
PCRE2_VERSION=10.44
LIBFFI_VERSION=3.4.6
GLIB_VERSION=2.82.2

# Minimum iOS version of every artefact in the sysroot.
IOS_MIN=16.0
